# Copy to .env.local and fill in. Never commit .env.local.
# Keys can also be saved on the /settings page (stored in MongoDB); those win over this file.

# Script writing (one is enough)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Image Studio only (paid)
ELEVENLABS_API_KEY=
LEONARDO_API_KEY=

# Database (Image Studio videos and settings). Atlas: add this PC's IP in Network Access.
MONGODB_URI=

# YouTube upload (Google Cloud OAuth client + refresh token; publish the consent screen first)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ComfyUI on the GPU PC (moving clips and AI pictures).
# ComfyUI Desktop listens on port 8000; the portable version on 8188. Run npm run comfy:check to test.
COMFY_URL=http://127.0.0.1:8188
# Optional: full path of the ComfyUI launcher (.exe or .bat). The app starts ComfyUI by itself when you press Make the video.
COMFY_START=

# Optional: path to a headless Chrome for Remotion renders
REMOTION_BROWSER=
